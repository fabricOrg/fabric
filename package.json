{
  "name": "app-platform",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @app/db generate",
    "db:migrate": "pnpm --filter @app/db migrate",
    "db:assert": "pnpm --filter @app/db db:assert",
    "db:gate": "pnpm db:migrate && pnpm db:assert && pnpm --filter @app/db db:assert:drift && pnpm --filter @app/db test:integration",
    "test:integration": "pnpm --filter @app/wallet --filter @app/sms-engine --filter @app/api --workspace-concurrency=1 run test:integration",
    "integration:gate": "pnpm db:gate && pnpm test:integration",
    "dev": "pnpm --filter @app/dashboard dev",
    "dev:api": "pnpm --filter @app/api dev",
    "dev:api:infisical": "infisical run --env=dev -- pnpm dev:api",
    "dev:seed": "node --env-file-if-exists=.env --conditions development --import tsx scripts/dev/seed-local.ts",
    "dev:seed:infisical": "infisical run --env=dev -- pnpm dev:seed",
    "dev:dashboard:infisical": "infisical run --env=dev -- pnpm dev",
    "dev:admin": "pnpm --filter @app/admin-console dev",
    "dev:sdk-playground": "npm --prefix examples/sdk-playground start",
    "dev:all": "pnpm build:shared && pnpm -r --parallel --filter @app/dashboard --filter @app/admin-console dev",
    "dev:all:infisical": "infisical run --env=dev -- pnpm dev:all",
    "dev:stack": "pnpm build:shared && pnpm -r --parallel --filter @app/api --filter @app/dashboard --filter @app/admin-console dev",
    "dev:stack:infisical": "pnpm db:up && infisical run --env=dev -- pnpm dev:stack",
    "lint": "biome check .",
    "lint:staged": "biome check --staged --no-errors-on-unmatched --files-ignore-unknown=true",
    "format": "biome format --write .",
    "build:shared": "pnpm --filter @app/contracts --filter @app/domain --filter @app/fe-auth build",
    "typecheck": "pnpm build:shared && pnpm -r --no-bail --if-present typecheck",
    "test": "pnpm build:shared && pnpm -r --no-bail --if-present test",
    "test:e2e": "playwright test",
    "build": "pnpm -r --no-bail --if-present build",
    "enforce:branch-name": "node ./scripts/git/validate-branch-name.mjs",
    "enforce:commit-message": "node ./scripts/git/validate-commit-message.mjs",
    "git:setup": "node ./scripts/git/configure-local.mjs",
    "guard:file-length": "node ./scripts/architecture/guard-file-length.mjs",
    "guard:browser-safe": "node ./scripts/architecture/guard-browser-safe.mjs",
    "guard": "pnpm guard:file-length && pnpm guard:browser-safe",
    "validate": "pnpm guard && pnpm lint && pnpm typecheck && pnpm test",
    "verify": "pnpm validate && pnpm build",
    "verify:full": "pnpm verify && pnpm integration:gate",
    "verify:full:infisical": "infisical run --env=dev -- pnpm verify:full",
    "verify:push": "node ./scripts/git/run-verified.mjs verify",
    "verify:full:changes": "node ./scripts/git/run-verified.mjs verify:full",
    "prepare": "husky"
  },
  "devDependencies": {
    "@app/db": "workspace:*",
    "@app/wallet": "workspace:*",
    "@biomejs/biome": "2.5.5",
    "@infisical/cli": "^0.43.113",
    "@playwright/test": "^1.61.1",
    "drizzle-orm": "^0.45.2",
    "husky": "^9.1.7",
    "postgres": "^3.4.0",
    "tsx": "^4.23.1",
    "turbo": "^2.10.6",
    "typescript": "^5.6.0",
    "vitest": "^3.2.7"
  }
}
