{
  "$schema": "https://turbo.build/schema.json",
  "//": "Turbo caches package tasks; global pass-through variables belong to root scripts and are not cache inputs.",
  "globalPassThroughEnv": [
    "DATABASE_URL_APP",
    "DATABASE_URL_SUPER",
    "DASHBOARD_API_KEY",
    "DEV_TENANT_ID",
    "GITHUB_BASE_REF",
    "GITHUB_HEAD_REF",
    "GITHUB_OUTPUT",
    "GITHUB_REF_NAME",
    "LIVE_API_KEY",
    "LIVE_SENDER_COUNTRY",
    "LIVE_SENDER_ID",
    "LIVE_TENANT_ID",
    "SEED_STAFF_EMAILS",
    "VERIFY_BASE_SHA",
    "WORKOS_ORGANIZATION_ID"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
