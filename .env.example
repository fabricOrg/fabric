# Copy to `.env` for local dev. Real values in cloud come from AWS Secrets Manager, never here.
# THREE roles (prod-faithful privilege model — see infra/dev/init/00-roles.sql):
#   - MIGRATOR (app_migrator): NON-super, owns tables, runs migrations. Used ONLY by drizzle-kit.
#     Non-super so FORCE ROW LEVEL SECURITY applies to the table owner exactly as in prod.
#   - APP (app_runtime):       NON-super runtime role. Cannot bypass RLS. Used by the services.
#   - SUPER (app_owner):       bootstrap superuser. TEST-ONLY cross-tenant sweeps / admin bootstrap.
#     Bypasses RLS — never the migration owner, never used by app code.

# Owner / migration connection — the NON-super migrator (drizzle-kit only).
DATABASE_URL_OWNER=postgresql://app_migrator:localdev@localhost:5432/app

# Application runtime connection (non-owner, RLS-enforced) — used by the services.
DATABASE_URL_APP=postgresql://app_runtime:localdev_app@localhost:5432/app

# Superuser connection — TEST-ONLY (e.g. QA global invariant sweeps that must read across tenants).
# Bypasses RLS; do NOT use for app code or migrations.
DATABASE_URL_SUPER=postgresql://app_owner:localdev@localhost:5432/app

# Dedicated cross-tenant JIT provisioning role. Local reuses bootstrap credentials; cloud must use
# a narrowly granted role limited to accounts/users/memberships.
DATABASE_URL_PROVISIONER=postgresql://app_owner:localdev@localhost:5432/app

# Temporary control-plane and fake-provider ingress credentials for local development.
OPERATOR_TOKEN=localdev-operator-token
WEBHOOK_INGRESS_TOKEN=localdev-webhook-token
BFF_INTERNAL_TOKEN=localdev-bff-token-change-before-sharing
# ADR-0003: HMAC secret the api signs short-lived BFF tenant tokens with (api-only).
TENANT_TOKEN_SECRET=localdev-tenant-token-secret-change-before-sharing
# ADR-0002: gate for self-serve sandbox sign-up (fail closed — anything but "true" is OFF).
SELF_SERVE_SIGNUP_ENABLED=true

# Redis tiers (mirror prod split)
REDIS_QUEUE_URL=redis://localhost:6379
REDIS_CACHE_URL=redis://localhost:6380

# Local dashboard BFF. Disposable local development only.
DASHBOARD_API_KEY=sk_test_dddddddddddddddddddddddddddddddddddddddd
API_BASE_URL=http://localhost:3000
DASHBOARD_BASE_URL=http://localhost:3100

# WorkOS customer realm — there is NO local dev-login bypass; local sign-in goes through the WorkOS
# Test env (email+password / Google / passkeys), same as every environment. Enable those methods in
# the WorkOS dashboard and register localhost:3100/auth/callback + /login. Real values in Infisical.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=
WORKOS_REDIRECT_URI=http://localhost:3100/auth/callback
WORKOS_LOGOUT_REDIRECT_URI=http://localhost:3100/login
WORKOS_ORGANIZATION_ID=
WORKOS_WEBHOOK_SECRET=

# DEPRECATED — the virtual phone no longer encrypts under this platform-wide key (it could not be
# destroyed for one person, so erasure could never reach it). Kept only until the one-off backfill
# has moved every existing virtual delivery into the PII vault.
VIRTUAL_PHONE_ENCRYPTION_KEY=replace-with-at-least-32-random-characters

# Required in production. Wraps the per-subject DEKs in the PII vault (COMPLIANCE §5). It never
# encrypts personal data directly — erasure works by destroying ONE subject's DEK, which a
# platform-wide key could not support. Losing this key makes all tenant PII permanently unreadable.
PII_MASTER_KEY=replace-with-at-least-32-random-characters
