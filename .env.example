# Copy to `.env` for local dev. Real values in cloud come from AWS Secrets Manager, never here.
# Two DATABASE URLs on purpose — the two-role security model (pre-impl review B4):
#   - OWNER role: runs migrations, owns tables. Used ONLY by drizzle-kit.
#   - APP role:   runtime queries. Non-owner, cannot bypass RLS. Used by the services.

# Owner / migration connection (local docker superuser)
DATABASE_URL_OWNER=postgresql://app_owner:localdev@localhost:5432/app

# Application runtime connection (created by migration 0000, non-owner, RLS-enforced)
DATABASE_URL_APP=postgresql://app_runtime:localdev_app@localhost:5432/app

# Redis tiers (mirror prod split)
REDIS_QUEUE_URL=redis://localhost:6379
REDIS_CACHE_URL=redis://localhost:6380
