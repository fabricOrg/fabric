{
  "name": "@fabric-messaging/cli",
  "version": "0.1.0-beta.8",
  "description": "Contract generation CLI for Fabric managed messaging",
  "license": "MIT",
  "type": "module",
  "bin": {
    "fabric": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabricOrg/fabric.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/fabricOrg/fabric/tree/dev/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/fabricOrg/fabric/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pack:check": "pnpm pack --dry-run",
    "packed:smoke": "node scripts/packed-smoke.mjs",
    "metadata:check": "node ../../scripts/release/assert-package-metadata.mjs .",
    "release:check": "pnpm metadata:check && pnpm typecheck && pnpm test && pnpm build && pnpm packed:smoke && pnpm pack:check"
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "vitest": "^3.2.7"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
