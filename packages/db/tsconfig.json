{
  // Typecheck config (`tsc --noEmit`) covering src + test + the drizzle/vitest configs. No
  // rootDir/outDir here (including drizzle.config.ts outside a src rootDir raised TS6059). The
  // emit/prod build is a separate src-only config → tsconfig.build.json (drives the `dist` export).
  "extends": "../../tsconfig.base.json",
  "include": [
    "src",
    "test",
    "drizzle.config.ts",
    "vitest.config.ts",
    "vitest.integration.config.ts"
  ]
}
