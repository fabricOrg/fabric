{
  "name": "@app/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs",
    "cloud:migrate": "node dist/cloud-migrate.js",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:assert": "tsx scripts/assert.ts",
    "db:assert:security": "tsx scripts/assert.ts security",
    "db:assert:ledger": "tsx scripts/assert.ts ledger",
    "db:assert:gl": "tsx scripts/assert.ts gl",
    "db:assert:recon": "tsx scripts/assert.ts recon",
    "db:assert:drift": "node scripts/assert-drift.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.1",
    "vitest": "^3.2.7"
  }
}
