---
import { Image } from "astro:assets";
import InteractiveDemo from "../components/InteractiveDemo.astro";
import CostCalculator from "../components/il/CostCalculator.astro";
import dispatchImg from "../assets/il/dispatch.png";
import coverageImg from "../assets/il/coverage.png";
import reliabilityImg from "../assets/il/reliability.png";
import dashboardOverviewImg from "../assets/dashboard-overview-sanitized.png";
import "../styles/global.css";

// Fabric landing — a short evaluation path: offer → product proof → sending models → managed
// messaging → price → coverage → production posture → docs. Claims stay grounded in shipped surfaces.
const APP_URL =
  import.meta.env.PUBLIC_DASHBOARD_URL ?? "https://fabric-dashboard-teal.vercel.app";
// Points at the API's UNAUTHENTICATED public snapshot, not the dashboard BFF: the data is public by
// intent, so it needs no credential and no coupling to the dashboard's uptime.
const PUBLIC_API_URL =
  import.meta.env.PUBLIC_API_URL ?? "https://fabric-jezz.onrender.com";
const PUBLIC_PRICING_URL = new URL("/v1/public/pricing", PUBLIC_API_URL).toString();

const why = [
  {
    t: "Direct SMS",
    d: "Send one message or a batch of up to 100. Follow each delivery.",
  },
  {
    t: "Direct email",
    d: "Send text or HTML from a verified domain. Retrieve every message.",
  },
  {
    t: "Managed messages",
    d: "Version SMS and email by stable key, locale, and typed variables.",
  },
  {
    t: "Preview before sending",
    d: "Render content, blockers, and cost before anything is sent.",
  },
];

const guarantees = [
  { t: "Sandbox + live", d: "Isolated application environments" },
  { t: "Safe retries", d: "Idempotent message creation" },
  { t: "Ledgered billing", d: "Trace every wallet movement" },
  { t: "Signed webhooks", d: "Verify and replay delivery events" },
];

const dxSteps = [
  { t: "Define", d: "Set the channel, copy, variables, locales, and sender." },
  { t: "Preview and release", d: "Render through the send path, then publish an immutable environment version." },
  { t: "Send and follow", d: "Call a stable key and follow the delivery or its signed webhook event." },
];

const prodReady = [
  {
    t: "Sending stays available",
    d: "Cached platform controls keep administrative outages out of the send path.",
  },
  {
    t: "Money fails closed",
    d: "A live message is not dispatched unless Fabric can reserve its cost.",
  },
  {
    t: "Durable delivery events",
    d: "Signed events are queued, retried, and replayable.",
  },
  {
    t: "Server-side keys",
    d: "Scoped keys stay on the server and can be revoked independently.",
  },
];

const quickstart = [
  { n: "1", t: "Install", c: "npm i @fabric-messaging/sdk" },
  { n: "2", t: "Add your key", c: "FABRIC_API_KEY=sk_test_…" },
  { n: "3", t: "Send", c: "fabric.messages.send(\"order.shipped\", { to, data, idempotencyKey })" },
  { n: "4", t: "Follow", c: "fabric.messages.retrieveDelivery(deliveryId)" },
];

const docs = [
  { t: "Quickstart", d: "Send a sandbox message with the Node SDK in minutes.", href: "/docs/quickstarts/working-quickstart/" },
  { t: "Managed messages", d: "Author, release, preview, and send versioned definitions.", href: "/docs/messaging/message-definitions/" },
  { t: "Email", d: "Send directly or publish managed email templates.", href: "/docs/email/" },
  { t: "Webhooks", d: "Verify signatures, handle events, replay a dead delivery.", href: "/docs/webhooks/" },
];

const faqs = [
  { q: "Do I need to fund an account to try Fabric?", a: "No. A sandbox key exercises rendering, pricing, delivery states, and webhooks over a virtual route. It does not contact a carrier or inbox, and it does not prove live deliverability." },
  { q: "What is the difference between direct and managed messaging?", a: "Direct SMS and email let your server own the final content. Managed messages store versioned SMS or email definitions in Fabric, so your application sends by stable key and content can change without a deploy." },
  { q: "Is Fabric only for SMS?", a: "No. Fabric supports direct and managed SMS and email today. Live SMS requires an approved sender ID, and live email requires a verified sending domain. WhatsApp, push, and voice remain on the roadmap." },
  { q: "How does pricing work?", a: "Pay per send from a prepaid wallet in local currency. SMS is billed per segment; email is billed at a flat rate per send. The calculator shows default rates, while your dashboard shows the rate book assigned to your workspace." },
  { q: "How long does sender-ID approval take?", a: "It's a manual carrier/regulator review with no fixed turnaround, so register early. You can keep testing your integration in sandbox while approval is pending." },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Fabric — SMS, email & managed messaging in one API</title>
    <meta name="description" content="Send direct SMS and email or publish versioned managed messages. Preview cost, follow delivery, and reconcile billing through one developer platform." />
    <meta name="theme-color" content="#383a96" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Fabric — SMS, email & managed messaging in one API" />
    <meta property="og:description" content="Send directly or by versioned definition, with preview parity, signed delivery webhooks, and billing you can reconcile." />
    <!-- og:image should be an absolute URL — prepend the public origin once the domain is fixed -->
    <meta property="og:image" content="/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <main class="shell" id="main-content">
      <header class="hdr">
        <a class="brand" href="/" aria-label="Fabric home">
          <svg class="mark" viewBox="0 0 64 64" width="26" height="26" aria-hidden="true">
            <rect width="64" height="64" rx="12" fill="var(--primary)"/>
            <path d="M18 14h31v9H28v9h18v9H28v15H18z" fill="var(--primary-foreground)"/>
          </svg>
          <span>Fabric</span>
        </a>
        <nav class="nav" aria-label="Primary">
          <a href="#product">Product</a><a href="#coverage">Coverage</a><a href="#pricing">Pricing</a><a href="/docs/">Docs</a>
          <a href={`${APP_URL}/signin`}>Sign in</a>
          <a class="btn btn-primary btn-sm" href={`${APP_URL}/signup`}>Start in sandbox</a>
        </nav>
        <details class="mobile-nav">
          <summary>Menu</summary>
          <nav aria-label="Mobile primary">
            <a href="#product">Product</a>
            <a href="#coverage">Coverage</a>
            <a href="#pricing">Pricing</a>
            <a href="/docs/">Docs</a>
            <a href={`${APP_URL}/signin`}>Sign in</a>
            <a class="btn btn-primary btn-sm" href={`${APP_URL}/signup`}>Start in sandbox</a>
          </nav>
        </details>
      </header>

      <!-- 1 · HERO -->
      <section class="hero">
        <figure class="hero-scene" role="img" aria-label="An application event passing through Fabric into SMS and email delivery routes.">
          <Image src={dispatchImg} alt="" widths={[595, 892, 1190]} sizes="(min-width: 48rem) 57vw, 100vw" format="webp" quality={90} loading="eager" fetchpriority="high" />
        </figure>
        <div class="hero-copy">
          <p class="kicker reveal" style="--d:0s">SMS + email / direct + managed</p>
          <h1 class="reveal" style="--d:.06s">Turn product events into <span class="hl">customer messages.</span></h1>
          <p class="hero-lede reveal" style="--d:.12s">Send directly, or manage versioned messages in Fabric.</p>
          <div class="actions reveal" style="--d:.18s">
            <a class="btn btn-primary" href={`${APP_URL}/signup`}>Start in sandbox</a>
            <a class="btn btn-line" href="/docs/quickstarts/working-quickstart/">See how it works →</a>
          </div>
        </div>
      </section>

      <!-- 2 · PRODUCT PROOF -->
      <section class="preview" aria-labelledby="preview-title">
        <div class="sec-head center">
          <p class="num">The product view</p>
          <h2 id="preview-title">Delivery and spend, <span class="hl">together</span>.</h2>
          <p class="section-lede">Follow direct and managed sends by channel, state, and cost, with the wallet balance beside them.</p>
        </div>
        <figure class="preview-frame product-shot">
          <Image
            src={dashboardOverviewImg}
            alt="Fabric sandbox dashboard showing message volume, delivery rate, spend, wallet balance, and delivery activity."
            widths={[720, 1080, 1680]}
            sizes="(min-width: 64rem) 68rem, calc(100vw - 3rem)"
            format="webp"
            quality={88}
            loading="lazy"
          />
        </figure>
      </section>

      <section class="trustbar" aria-label="Platform guarantees">
        <ul class="guarantees">
          {guarantees.map((item) => (
            <li><strong>{item.t}</strong><span>{item.d}</span></li>
          ))}
        </ul>
      </section>

      <!-- 3 · WHY FABRIC -->
      <section class="why" id="product">
        <div class="sec-head">
          <p class="num">Two ways to send</p>
          <h2>Direct APIs or managed messages. <span class="hl">One operating model.</span></h2>
          <p class="section-lede">Keep final content in your application, or move versioned copy and channel decisions into Fabric. Both paths share environments, delivery states, webhooks, and billing.</p>
        </div>
        <div class="why-grid">
          {why.map((w) => (<div class="why-card"><h3>{w.t}</h3><p>{w.d}</p></div>))}
        </div>
      </section>

      <!-- 4 · DEVELOPER EXPERIENCE -->
      <section class="dx">
        <div class="sec-head">
          <p class="num">Managed messaging</p>
          <h2>Version the message, <span class="hl">not the deploy</span>.</h2>
          <p class="section-lede">A definition owns the channel and content. Your application sends a stable key through the typed SDK.</p>
        </div>
        <div class="dx-grid">
          <ol class="journey">
            {dxSteps.map((s, i) => (
              <li><span class="j-n">{i + 1}</span><div><strong>{s.t}</strong><p>{s.d}</p></div></li>
            ))}
          </ol>
          <InteractiveDemo />
        </div>
      </section>

      <!-- 5 · PRICING -->
      <section class="pricing" id="pricing">
        <div class="sec-head center">
          <p class="num">Pricing</p>
          <h2>Know the cost <span class="hl">before the send</span>.</h2>
          <p class="section-lede">SMS is billed per segment and email at a flat rate per send. Every reservation, charge, and refund stays on the ledger.</p>
        </div>
        <CostCalculator pricingUrl={PUBLIC_PRICING_URL} />
        <p class="price-foot">Sandbox activity uses test credits and never contacts a carrier or inbox. Your dashboard shows the rate book assigned to your workspace.</p>
      </section>

      <!-- 6 · COVERAGE -->
      <section class="coverage" id="coverage">
        <div class="cov-copy">
          <p class="num">Coverage</p>
          <h2>Built for delivery in <span class="hl">Ghana & Nigeria</span>.</h2>
          <p>Sender-ID approval, recipient consent, DND status, and promotional quiet hours are send-path controls, not a checklist your team has to remember.</p>
          <ul class="cov-legend">
            <li><span class="dot live"></span>Transactional SMS routes — Ghana & Nigeria</li>
            <li><span class="dot live"></span>Email — verified sending domains</li>
            <li><span class="dot help"></span>Sender-ID registration — Ghana & Nigeria</li>
            <li><span class="dot soon"></span>WhatsApp, push & voice — roadmap</li>
          </ul>
          <div class="actions"><a class="btn btn-line" href="/docs/messaging/sender-ids/">Sender IDs & registration →</a></div>
        </div>
        <figure class="il cov-visual"><Image src={coverageImg} alt="Ghana (Accra) and Nigeria (Lagos) as the live delivery corridors on a stylised West Africa map, with further regions dimmed." widths={[300, 440, 560]} sizes="(min-width: 62rem) 28rem, 88vw" format="webp" quality={88} loading="lazy" /></figure>
      </section>

      <!-- 7 · RELIABILITY & SECURITY -->
      <section class="split">
        <div class="split-top">
          <div class="sec-head">
            <p class="num">Production readiness</p>
            <h2>Designed for failure <span class="hl">and recovery</span>.</h2>
            <p class="section-lede">Sending remains available through administrative outages, money stays protected, and delivery outcomes remain recoverable.</p>
          </div>
          <figure class="il split-il"><Image src={reliabilityImg} alt="Message packets moving through a retryable delivery pipeline protected by a fail-closed wallet check." widths={[360, 480, 567]} sizes="(min-width: 62rem) 30rem, 80vw" format="webp" quality={88} loading="lazy" /></figure>
        </div>
        <div class="cardgrid">
          {prodReady.map((r) => (<div class="mini"><h3>{r.t}</h3><p>{r.d}</p></div>))}
        </div>
      </section>

      <!-- 8 · DOCS / QUICKSTART -->
      <section class="docs">
        <div class="sec-head">
          <p class="num">Quick start</p>
          <h2>From install to delivery in <span class="hl">four steps</span>.</h2>
        </div>
        <div class="qs-grid">
          <ol class="qs-steps">
            {quickstart.map((q) => (
              <li><span class="qs-n">{q.n}</span><div><strong>{q.t}</strong><code>{q.c}</code></div></li>
            ))}
          </ol>
          <div class="docs-cards">
            {docs.map((d) => (
              <a class="doc-card" href={d.href}><h3>{d.t}<span class="parr" aria-hidden="true">→</span></h3><p>{d.d}</p></a>
            ))}
          </div>
        </div>
      </section>

      <!-- 9 · FAQ -->
      <section class="faq">
        <div class="sec-head">
          <p class="num">FAQ</p>
          <h2>Questions before <span class="hl">you start</span>.</h2>
        </div>
        <div class="faq-list">
          {faqs.map((f) => (
            <details class="qa">
              <summary>{f.q}<span class="q-mark" aria-hidden="true">+</span></summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <!-- 10 · CTA -->
      <section class="cta">
        <h2>Run a real messaging flow in sandbox.</h2>
        <p>Use a test key to send directly or by managed definition without contacting a carrier or inbox.</p>
        <div class="actions"><a class="btn btn-primary" href={`${APP_URL}/signup`}>Start in sandbox</a><a class="btn btn-line" href="/docs/quickstarts/working-quickstart/">Open the Node quickstart →</a></div>
      </section>

      <!-- FOOTER -->
      <footer class="ftr">
        <div class="ftr-top">
          <div class="ftr-brand">
            <span class="brand-sm">Fabric</span>
            <p>Direct SMS, email, and managed messaging through one developer platform.</p>
          </div>
          <div class="ftr-cols">
            <div><h4>Product</h4><a href="#product">Messaging</a><a href="#coverage">Coverage</a><a href="#pricing">Pricing</a></div>
            <div><h4>Developers</h4><a href="/docs/">Docs</a><a href="/docs/quickstarts/working-quickstart/">Quickstart</a><a href="/docs/sdks-tools/node/">SDK & CLI</a><a href="/docs/webhooks/">Webhooks</a></div>
            <div><h4>Resources</h4><a href="/docs/guides/">Guides</a><a href="/docs/messaging/delivery-reports/">Delivery</a><a href="/docs/account/compliance/">Compliance</a></div>
            <div><h4>Account</h4><a href={`${APP_URL}/signup`}>Start in sandbox</a><a href={`${APP_URL}/signin`}>Sign in</a></div>
          </div>
        </div>
        <div class="ftr-legal"><span>© 2026 Fabric</span><span>Built for Ghana & Nigeria</span></div>
      </footer>
    </main>

    <script is:inline>
      (() => {
        // Close the mobile menu after a same-page anchor tap (a <details> panel stays open otherwise).
        const mnav = document.querySelector(".mobile-nav");
        mnav?.addEventListener("click", (e) => {
          if (e.target instanceof Element && e.target.closest("a")) mnav.removeAttribute("open");
        });
        // Scroll-reveal for section heads. Classes are added here, not in markup, so no-JS and
        // reduced-motion readers get fully static content.
        if (!("IntersectionObserver" in window) || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        const io = new IntersectionObserver(
          (entries) => {
            for (const en of entries) {
              if (en.isIntersecting) {
                en.target.classList.add("in");
                io.unobserve(en.target);
              }
            }
          },
          { rootMargin: "0px 0px -10% 0px" },
        );
        for (const el of document.querySelectorAll(".sec-head, .trustbar, .cov-copy, .cta, .preview-frame")) {
          el.classList.add("pre");
          io.observe(el);
        }
      })();
    </script>

    <style>
      :root { --maxw: 74rem; --section-y: clamp(3.75rem, 6.5vw, 6.25rem); --head-gap: clamp(2.25rem, 4vw, 3.5rem); --card-pad: 1.7rem 1.55rem; }
      body { background: var(--background); }
      .shell { overflow-x: clip; color: var(--foreground); background: var(--background); }
      .hdr, .hero, .why, .trustbar, .dx, .split, .pricing, .coverage, .preview, .docs, .faq, .cta, .ftr { margin-inline: auto; width: min(100% - 3rem, var(--maxw)); }
      .skip-link { position: fixed; z-index: 100; inset: 0 auto auto 1rem; transform: translateY(-120%); padding: .7rem 1rem; background: var(--primary); color: var(--primary-foreground); font-weight: 600; text-decoration: none; }
      .skip-link:focus { transform: translateY(.75rem); }

      .hdr { position: relative; display: flex; align-items: center; justify-content: space-between; padding-block: 1.3rem; }
      .brand { display: inline-flex; align-items: center; gap: .55rem; color: var(--foreground); font-family: var(--font-display); font-weight: 700; font-size: 1.25rem; text-decoration: none; }
      .nav { display: flex; align-items: center; gap: 1.4rem; }
      .nav a { color: var(--muted-foreground); font-size: .9375rem; text-decoration: none; }
      .nav a:hover { color: var(--foreground); }
      .nav .btn-primary { color: #fff; }
      .nav .btn-primary:hover { color: #fff; }
      .mobile-nav { display: none; }
      .mobile-nav summary { cursor: pointer; color: var(--foreground); font-weight: 600; font-size: .9rem; list-style: none; }
      .mobile-nav summary::-webkit-details-marker { display: none; }
      .mobile-nav nav { position: absolute; z-index: 20; inset: calc(100% - .6rem) 0 auto; display: grid; padding: .6rem; border: 1px solid var(--border); background: var(--card); box-shadow: 0 18px 35px -25px rgba(20,20,32,.5); }
      .mobile-nav nav a:not(.btn) { padding: .8rem; color: var(--foreground); text-decoration: none; }
      .mobile-nav .btn { margin-top: .4rem; }

      .btn { display: inline-flex; align-items: center; justify-content: center; min-height: 2.85rem; padding-inline: 1.35rem; font-weight: 600; font-size: .95rem; text-decoration: none; border: 1px solid transparent; transition: transform .05s, filter .15s, border-color .15s, color .15s; }
      .btn:active { transform: translateY(1px); }
      .btn-sm { min-height: 2.3rem; padding-inline: 1rem; font-size: .875rem; }
      .btn-primary { background: var(--primary); color: #fff; }
      .btn-primary:hover { filter: brightness(1.1); }
      .btn-line { background: var(--card); color: var(--foreground); border-color: var(--border); }
      .btn-line:hover { border-color: var(--primary); color: var(--primary); }

      /* shared type + section heads */
      .kicker, .num { margin: 0; color: var(--gold-ink); font-family: var(--font-mono); font-size: .75rem; letter-spacing: .1em; text-transform: uppercase; }
      h1, h2, h3 { font-family: var(--font-display); font-weight: 700; letter-spacing: 0; }
      .hl { color: var(--primary); }
      .sec-head { max-width: 44rem; }
      .sec-head.center { margin-inline: auto; text-align: center; }
      .sec-head h2 { margin: .6rem 0 0; font-size: clamp(1.9rem,3.7vw,2.7rem); line-height: 1.05; }
      .section-lede { margin: 1rem 0 0; color: var(--muted-foreground); line-height: 1.6; }
      .sec-head.center .section-lede { margin-inline: auto; }
      :is(#product, #pricing, #coverage) { scroll-margin-top: 1.5rem; }

      /* hero */
      .hero { position: relative; isolation: isolate; display: grid; width: 100%; max-width: none; min-height: min(48rem, calc(100svh - 5.5rem)); overflow: hidden; padding: clamp(4rem, 7vw, 6.5rem) max(1.5rem, calc((100% - var(--maxw)) / 2)); background-color: #f8f5f1; background-image: radial-gradient(color-mix(in oklab, var(--foreground) 6%, transparent) 1px, transparent 1px); background-size: 26px 26px; background-position: -13px -13px; }
      .hero-scene { position: absolute; z-index: 0; inset: 2rem max(1.5rem, calc((100% - var(--maxw)) / 2)) 2rem 43%; margin: 0; pointer-events: none; }
      .hero-scene :global(img) { display: block; width: 100%; height: 100%; object-fit: contain; object-position: center; }
      .hero-copy { position: relative; z-index: 1; align-self: center; width: min(40rem, 52vw); }
      .hero .kicker { color: var(--gold-ink); }
      .hero h1 { margin: .9rem 0 0; color: var(--foreground); font-size: clamp(2.8rem,4.1vw,3.9rem); line-height: 1; }
      .hero .hl { color: var(--primary); }
      .hero-lede { max-width: 28rem; margin: 1.25rem 0 0; color: var(--muted-foreground); font-size: 1.08rem; line-height: 1.55; }
      .actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
      @media (max-width: 47.99rem) {
        .hero { min-height: 0; padding-block: 3.25rem 0; }
        .hero-copy { width: min(100%, 32rem); }
        .hero h1 { max-width: 30rem; font-size: clamp(2.55rem, 12vw, 3.5rem); }
        .hero-scene { position: relative; inset: auto; width: calc(100% + 3rem); aspect-ratio: 1.58 / 1; margin: 2.5rem -1.5rem 0; grid-row: 2; }
      }

      /* why */
      .why { padding-block: var(--section-y); }
      .why-grid { display: grid; gap: 1px; margin-top: var(--head-gap); background: var(--border); border: 1px solid var(--border); }
      @media (min-width: 52rem) { .why-grid { grid-template-columns: repeat(2,1fr); } }
      @media (min-width: 74rem) { .why-grid { grid-template-columns: repeat(4,1fr); } }
      .why-card { background: var(--card); padding: var(--card-pad); border-top: 3px solid var(--primary); }
      .why-card:nth-child(1) { border-top-color: var(--sms); }
      .why-card:nth-child(2) { border-top-color: var(--email); }
      .why-card:nth-child(3) { border-top-color: var(--gold); }
      .why-card h3 { margin: 0 0 .5rem; font-size: 1.08rem; }
      .why-card p { margin: 0; color: var(--muted-foreground); font-size: .92rem; line-height: 1.55; }

      /* trust strip — engineering guarantees */
      .trustbar { padding-block: clamp(1.8rem, 3vw, 2.5rem); border-block: 1px solid var(--border); }
      .guarantees { display: grid; grid-template-columns: repeat(2,1fr); gap: 1.2rem 1.5rem; margin: 0; padding: 0; list-style: none; }
      @media (min-width: 56rem) { .guarantees { grid-template-columns: repeat(4,1fr); } }
      .guarantees li { display: grid; gap: .2rem; text-align: center; }
      .guarantees strong { font-family: var(--font-display); font-size: .95rem; color: var(--foreground); }
      .guarantees span { font-size: .8rem; color: var(--muted-foreground); }

      /* shared illustration frame */
      .il { margin: 0; }
      .il :global(img) { display: block; width: 100%; height: auto; filter: drop-shadow(0 30px 40px rgba(30,27,75,.16)); }

      /* dx journey */
      .dx, .docs, .cta { position: relative; isolation: isolate; }
      .dx::before, .docs::before, .cta::before {
        position: absolute;
        z-index: -1;
        inset-block: 0;
        left: 50%;
        width: 100dvw;
        transform: translateX(-50%);
        content: "";
      }
      .dx { padding-block: var(--section-y); }
      .dx::before { background: var(--card); }
      .dx-grid { display: grid; gap: 2.5rem; margin-top: var(--head-gap); align-items: start; }
      @media (min-width: 62rem) { .dx-grid { grid-template-columns: 1fr 1fr; } }
      .dx-grid > *, .split-top > *, .coverage > *, .qs-grid > * { min-width: 0; }
      .journey { display: grid; gap: 1.4rem; margin: 0; padding: 0; list-style: none; counter-reset: j; }
      .journey li { display: grid; grid-template-columns: auto 1fr; gap: 1rem; }
      .j-n { display: grid; place-items: center; width: 1.7rem; height: 1.7rem; border-radius: 50%; background: color-mix(in oklab, var(--primary) 12%, transparent); color: var(--primary); font-family: var(--font-mono); font-size: .8rem; font-weight: 600; }
      .journey strong { font-family: var(--font-display); font-size: 1.02rem; }
      .journey p { margin: .25rem 0 0; color: var(--muted-foreground); font-size: .9rem; line-height: 1.5; }
      .dx-il { max-width: 32rem; margin-inline: auto; }

      /* production readiness */
      .split { padding-block: var(--section-y); }
      .split-top { display: grid; gap: 2rem; align-items: center; }
      @media (min-width: 62rem) { .split-top { grid-template-columns: 1.1fr .9fr; } }
      .split-il { width: 100%; max-width: 30rem; margin-inline: auto; }
      .cardgrid { display: grid; grid-template-columns: 1fr; gap: 1px; margin-top: var(--head-gap); background: var(--border); border: 1px solid var(--border); }
      @media (min-width: 48rem) { .cardgrid { grid-template-columns: 1fr 1fr; } }
      .mini { background: var(--card); padding: var(--card-pad); }
      .mini h3 { margin: 0 0 .45rem; font-size: 1.02rem; }
      .mini p { margin: 0; color: var(--muted-foreground); font-size: .9rem; line-height: 1.5; }

      /* pricing */
      .pricing { padding-block: var(--section-y); }
      .price-foot { margin-top: 2rem; text-align: center; color: var(--muted-foreground); font-size: .9rem; }
      .price-foot strong { color: var(--foreground); }

      /* coverage */
      .coverage { display: grid; gap: 2.5rem; align-items: center; padding-block: var(--section-y); }
      @media (min-width: 62rem) { .coverage { grid-template-columns: 1.05fr .95fr; } }
      .cov-copy h2 { margin: .6rem 0 0; font-size: clamp(1.9rem,3.7vw,2.7rem); line-height: 1.05; }
      .cov-copy > p { margin: 1rem 0 1.4rem; color: var(--muted-foreground); line-height: 1.6; }
      .cov-legend { display: grid; gap: .6rem; margin: 0 0 1.6rem; padding: 0; list-style: none; }
      .cov-legend li { display: flex; align-items: center; gap: .6rem; font-size: .9rem; color: var(--foreground); }
      .cov-legend .dot { width: .7rem; height: .7rem; border-radius: 50%; }
      .cov-legend .dot.live { background: var(--ok); animation: dotPulse 2.4s ease-in-out infinite; }
      @keyframes dotPulse { 50% { box-shadow: 0 0 0 4px color-mix(in oklab, var(--ok) 18%, transparent); } }
      .cov-legend .dot.help { background: var(--gold); }
      .cov-legend .dot.soon { background: color-mix(in oklab, var(--foreground) 25%, transparent); }
      .cov-visual { width: min(100%, 28rem); margin: 0 auto; }

      /* dashboard preview */
      .preview { padding-block: var(--section-y); }
      .preview-frame { max-width: 68rem; margin: var(--head-gap) auto 0; }
      .product-shot { overflow: hidden; border: 1px solid var(--border); background: var(--card); box-shadow: 0 40px 80px -54px rgba(20,20,32,.55); }
      .product-shot :global(img) { display: block; width: 100%; height: auto; }

      /* docs / quickstart */
      .docs { padding-block: var(--section-y); }
      .docs::before { background: color-mix(in oklab, var(--primary) 3%, var(--background)); }
      .qs-grid { display: grid; gap: 2.5rem; margin-top: var(--head-gap); }
      @media (min-width: 62rem) { .qs-grid { grid-template-columns: 1fr 1fr; } }
      .qs-steps { display: grid; gap: 1rem; margin: 0; padding: 0; list-style: none; }
      .qs-steps li { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: .9rem; align-items: start; }
      .qs-steps li > div { min-width: 0; }
      .qs-n { display: grid; place-items: center; width: 1.6rem; height: 1.6rem; background: var(--primary); color: #fff; font-family: var(--font-mono); font-size: .78rem; font-weight: 600; }
      .qs-steps strong { display: block; font-family: var(--font-display); font-size: .98rem; margin-bottom: .3rem; }
      .qs-steps code { display: block; overflow-x: auto; padding: .5rem .6rem; background: #15151f; color: #c7c9e0; border: 1px solid #2a2b3d; font-family: var(--font-mono); font-size: .76rem; }
      .docs-cards { display: grid; gap: 1px; background: var(--border); border: 1px solid var(--border); align-content: start; }
      @media (min-width: 32rem) { .docs-cards { grid-template-columns: 1fr 1fr; } }
      .doc-card { display: block; background: var(--card); padding: var(--card-pad); color: inherit; text-decoration: none; transition: background .15s; }
      .doc-card:hover { background: color-mix(in oklab, var(--primary) 5%, var(--card)); }
      .doc-card h3 { display: flex; align-items: center; gap: .4rem; margin: 0 0 .35rem; font-size: 1rem; }
      .doc-card p { margin: 0; color: var(--muted-foreground); font-size: .86rem; line-height: 1.45; }
      .parr { color: var(--primary); opacity: 0; transform: translateX(-.25rem); transition: opacity .15s, transform .15s; }
      .doc-card:hover .parr, .doc-card:focus-visible .parr { opacity: 1; transform: none; }

      /* faq */
      .faq { padding-block: var(--section-y); }
      .faq-list { max-width: 48rem; margin: var(--head-gap) 0 0; border-top: 1px solid var(--border); }
      .qa { border-bottom: 1px solid var(--border); }
      .qa summary { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1.2rem .2rem; cursor: pointer; list-style: none; font-family: var(--font-display); font-weight: 600; font-size: 1.05rem; color: var(--foreground); }
      .qa summary::-webkit-details-marker { display: none; }
      .q-mark { color: var(--primary); font-family: var(--font-mono); font-size: 1.3rem; transition: transform .2s; }
      .qa[open] .q-mark { transform: rotate(45deg); }
      .qa p { margin: 0 0 1.2rem; max-width: 44rem; color: var(--muted-foreground); line-height: 1.6; }
      .qa[open] p { animation: fadeUp .3s cubic-bezier(.2,.7,.2,1); }

      /* cta */
      .cta { text-align: center; padding-block: calc(var(--section-y) * 1.25); color: #fff; }
      .cta::before { background: var(--primary); }
      .cta h2 { margin: 0; font-size: clamp(2.1rem,4.4vw,3.2rem); }
      .cta p { margin: .8rem auto 0; max-width: 36rem; color: rgba(255,255,255,.78); }
      .cta .actions { justify-content: center; }
      .cta .btn-primary { background: #fff; color: var(--primary); }
      .cta .btn-primary:hover { color: var(--primary); }
      .cta .btn-line { border-color: rgba(255,255,255,.48); background: transparent; color: #fff; }
      .cta .btn-line:hover { border-color: #fff; color: #fff; }

      /* footer */
      .ftr { padding-block: 3rem 2.2rem; border-top: 1px solid var(--border); }
      .ftr-top { display: grid; gap: 2.5rem; }
      @media (min-width: 52rem) { .ftr-top { grid-template-columns: 1.1fr 2fr; } }
      .ftr-brand .brand-sm { font-family: var(--font-display); font-weight: 700; font-size: 1.2rem; color: var(--foreground); }
      .ftr-brand p { margin: .6rem 0 0; max-width: 22rem; color: var(--muted-foreground); font-size: .9rem; line-height: 1.5; }
      .ftr-cols { display: grid; grid-template-columns: repeat(2,1fr); gap: 1.5rem; }
      @media (min-width: 44rem) { .ftr-cols { grid-template-columns: repeat(4,1fr); } }
      .ftr-cols h4 { margin: 0 0 .8rem; font-family: var(--font-mono); font-size: .72rem; letter-spacing: .08em; text-transform: uppercase; color: var(--muted-foreground); font-weight: 500; }
      .ftr-cols a { display: block; padding: .3rem 0; color: var(--foreground); text-decoration: none; font-size: .9rem; }
      .ftr-cols a:hover { color: var(--primary); }
      .ftr-legal { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .5rem; margin-top: var(--head-gap); padding-top: 1.5rem; border-top: 1px solid var(--border); color: var(--muted-foreground); font-size: .82rem; }

      /* motion */
      .reveal { opacity: 0; transform: translateY(14px); animation: fadeUp .7s cubic-bezier(.2,.7,.2,1) forwards; animation-delay: var(--d,0s); }
      @keyframes fadeUp { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
      /* scroll-reveal — .pre is added by JS only when IO exists and motion is allowed, so no-JS
       * and reduced-motion readers always see static content */
      :global(.pre) { opacity: 0; transform: translateY(14px); transition: opacity .65s cubic-bezier(.2,.7,.2,1), transform .65s cubic-bezier(.2,.7,.2,1); }
      :global(.pre.in) { opacity: 1; transform: none; }
      @media (max-width: 48rem) { .nav { display: none; } .mobile-nav { display: block; } }
      @media (max-width: 32rem) {
        :root { --card-pad: 1.35rem 1.15rem; }
        .hdr, .why, .trustbar, .dx, .split, .pricing, .coverage, .preview, .docs, .faq, .cta, .ftr { width: min(100% - 2rem, var(--maxw)); }
        .hero { padding-inline: 1rem; }
        .hero-scene { width: calc(100% + 2rem); margin-inline: -1rem; }
        .actions { align-items: stretch; }
        .actions .btn { flex: 1 1 100%; width: 100%; }
        .guarantees { grid-template-columns: 1fr; }
        .cov-legend li { align-items: flex-start; }
        .cov-legend .dot { flex: 0 0 auto; margin-top: .32rem; }
        .ftr-cols { grid-template-columns: 1fr 1fr; gap: 1.5rem 1rem; }
      }
      @media (prefers-reduced-motion: reduce) {
        .reveal { animation: none; opacity: 1; transform: none; }
        .qa[open] p { animation: none; }
        .cov-legend .dot.live { animation: none; }
      }
      :is(a, summary, details):focus-visible { outline: 2px solid var(--ring); outline-offset: 3px; }
    </style>
  </body>
</html>
