      @media (min-width: 52rem) { .why-grid { grid-template-columns: repeat(2,1fr); } }
      @media (min-width: 74rem) { .why-grid { grid-template-columns: repeat(4,1fr); } }
      .why-card { background: var(--card); padding: var(--card-pad); border-top: 3px solid var(--primary); }
      .why-card h3 { margin: 0 0 .5rem; font-size: 1.08rem; }
      .why-card p { margin: 0; color: var(--muted-foreground); font-size: .92rem; line-height: 1.55; }

      /* trust strip — engineering guarantees */
      .trustbar { padding-block: clamp(2.25rem, 3.5vw, 3.25rem); border-block: 1px solid var(--border); }
      .tb-lead { margin: 0 0 1.4rem; text-align: center; color: var(--muted-foreground); font-size: .95rem; }
      .guarantees { display: grid; grid-template-columns: repeat(2,1fr); gap: 1.2rem 1.5rem; margin: 0; padding: 0; list-style: none; }
      @media (min-width: 56rem) { .guarantees { grid-template-columns: repeat(5,1fr); } }
      .guarantees li { display: grid; gap: .2rem; text-align: center; }
      .guarantees strong { font-family: var(--font-display); font-size: .95rem; color: var(--foreground); }
      .guarantees span { font-size: .8rem; color: var(--muted-foreground); }

      /* shared illustration frame */
      .il { margin: 0; }
      .il :global(img) { display: block; width: 100%; height: auto; filter: drop-shadow(0 30px 40px rgba(30,27,75,.16)); }

      /* dx journey */
      .dx { padding-block: var(--section-y); }
      .dx-grid { display: grid; gap: 2.5rem; margin-top: var(--head-gap); align-items: center; }
      @media (min-width: 62rem) { .dx-grid { grid-template-columns: 1fr 1fr; } }
      .journey { display: grid; gap: 1.4rem; margin: 0; padding: 0; list-style: none; counter-reset: j; }
      .journey li { display: grid; grid-template-columns: auto 1fr; gap: 1rem; }
      .j-n { display: grid; place-items: center; width: 1.7rem; height: 1.7rem; border-radius: 50%; background: color-mix(in oklab, var(--primary) 12%, transparent); color: var(--primary); font-family: var(--font-mono); font-size: .8rem; font-weight: 600; }
      .journey strong { font-family: var(--font-display); font-size: 1.02rem; }
      .journey p { margin: .25rem 0 0; color: var(--muted-foreground); font-size: .9rem; line-height: 1.5; }
      .dx-il { max-width: 32rem; margin-inline: auto; }

      /* platform capabilities */
      .platform { padding-block: var(--section-y); }
      .cap-grid { display: grid; gap: 1px; margin-top: var(--head-gap); background: var(--border); border: 1px solid var(--border); }
      @media (min-width: 40rem) { .cap-grid { grid-template-columns: repeat(2,1fr); } }
      @media (min-width: 64rem) { .cap-grid { grid-template-columns: repeat(4,1fr); } }
      .cap-card { background: var(--card); padding: var(--card-pad); }
      .cap-ic { display: inline-grid; place-items: center; width: 2.4rem; height: 2.4rem; margin-bottom: .8rem; background: color-mix(in oklab, var(--primary) 10%, transparent); color: var(--primary); transition: background .2s; }
      .cap-card:hover .cap-ic { background: color-mix(in oklab, var(--primary) 16%, transparent); }
      /* set:html paths carry no Astro scope attr, so every shape hook below must be :global.
       * Icons draw themselves in when the grid scrolls into view: each shape has pathLength=1,
       * so a unit dash + offset animates 1 -> 0. Without JS (.pre never added) they render drawn. */
      .cap-ic :global(:is(path, circle, rect)) { stroke-dasharray: 1; }
      .cap-grid.pre .cap-ic :global(:is(path, circle, rect)) { stroke-dashoffset: 1; }
      .cap-grid.in .cap-ic :global(:is(path, circle, rect)) { animation: draw 4.5s ease-in-out infinite; animation-delay: calc(var(--i) * 120ms); }
      .cap-grid.in .cap-ic :global(.acc) { animation-delay: calc(var(--i) * 120ms + .4s); }
      /* infinite trace: draw in, hold drawn, trace out the same direction — offset -1 and 1 are
       * both fully hidden with a unit dash, so the loop wraps seamlessly */
      @keyframes draw {
        0% { stroke-dashoffset: 1; }
        30% { stroke-dashoffset: 0; }
        72% { stroke-dashoffset: 0; }
        100% { stroke-dashoffset: -1; }
      }
      .cap-ic :global(.acc) { stroke: var(--gold-ink); transform-box: fill-box; transform-origin: center; transition: transform .25s cubic-bezier(.34,1.56,.64,1); }
      .cap-card:hover .cap-ic :global(.acc) { transform: scale(1.15); }
      .cap-card h3 { margin: 0 0 .35rem; font-size: 1.05rem; }
      .cap-card p { margin: 0; color: var(--muted-foreground); font-size: .88rem; line-height: 1.5; }
      .chan-note { display: flex; flex-wrap: wrap; justify-content: center; gap: .6rem 1.2rem; margin-top: 1.8rem; font-size: .85rem; }
      .cn-live { color: var(--ok); font-weight: 600; }
      .cn-soon { color: var(--muted-foreground); }

      /* production readiness (merged) */
      .split { padding-block: var(--section-y); }
      .split-top { display: grid; gap: 2rem; align-items: center; }
      @media (min-width: 62rem) { .split-top { grid-template-columns: 1.1fr .9fr; } }
      .split-il { width: 100%; max-width: 30rem; margin-inline: auto; }
      .cardgrid { display: grid; gap: 1px; margin-top: var(--head-gap); background: var(--border); border: 1px solid var(--border); }
      .cardgrid.three { grid-template-columns: 1fr; }
      @media (min-width: 48rem) { .cardgrid.three { grid-template-columns: 1fr 1fr; } }
      @media (min-width: 72rem) { .cardgrid.three { grid-template-columns: repeat(3,1fr); } }
      .mini { background: var(--card); padding: var(--card-pad); }
      .mini h3 { margin: 0 0 .45rem; font-size: 1.02rem; }
      .mini p { margin: 0; color: var(--muted-foreground); font-size: .9rem; line-height: 1.5; }

      /* pricing / wallet flow */
      .pricing { padding-block: var(--section-y); }
      .wallet-flow { display: grid; gap: 2.5rem; margin-top: var(--head-gap); align-items: center; }
      @media (min-width: 62rem) { .wallet-flow { grid-template-columns: .9fr 1.1fr; } }
      .wf-il { max-width: 24rem; margin-inline: auto; }
      .flow-steps { display: grid; gap: 1rem; margin: 0; padding: 0; list-style: none; }
      @media (min-width: 40rem) { .flow-steps { grid-template-columns: 1fr 1fr; } }
      .flow-steps li { display: grid; grid-template-columns: auto 1fr; gap: .8rem; align-items: start; }
      .f-n { display: grid; place-items: center; width: 1.6rem; height: 1.6rem; background: color-mix(in oklab, var(--gold) 16%, transparent); color: var(--gold-ink); font-family: var(--font-mono); font-size: .78rem; font-weight: 600; }
      .flow-steps strong { font-family: var(--font-display); font-size: .98rem; }
      .flow-steps p { margin: .2rem 0 0; color: var(--muted-foreground); font-size: .85rem; line-height: 1.45; }
      .price-foot { margin-top: 2rem; text-align: center; color: var(--muted-foreground); font-size: .9rem; }
      .price-foot strong { color: var(--foreground); }

      /* coverage */
      .coverage { display: grid; gap: 2.5rem; align-items: center; padding-block: var(--section-y); }
      @media (min-width: 62rem) { .coverage { grid-template-columns: 1.05fr .95fr; } }
      .cov-copy h2 { margin: .6rem 0 0; font-size: clamp(1.9rem,3.7vw,2.7rem); line-height: 1.05; }
      .cov-copy > p { margin: 1rem 0 1.4rem; color: var(--muted-foreground); line-height: 1.6; }
      .cov-legend { display: grid; gap: .6rem; margin: 0 0 1.6rem; padding: 0; list-style: none; }
      .cov-legend li { display: flex; align-items: center; gap: .6rem; font-size: .9rem; color: var(--foreground); }
      .cov-legend .dot { width: .7rem; height: .7rem; border-radius: 50%; }
      .cov-legend .dot.live { background: var(--ok); animation: dotPulse 2.4s ease-in-out infinite; }
      @keyframes dotPulse { 50% { box-shadow: 0 0 0 4px color-mix(in oklab, var(--ok) 18%, transparent); } }
      .cov-legend .dot.help { background: var(--gold); }
      .cov-legend .dot.soon { background: color-mix(in oklab, var(--foreground) 25%, transparent); }
      .cov-visual { width: min(100%, 28rem); margin: 0 auto; }

      /* dashboard preview */
      .preview { padding-block: var(--section-y); }
      .preview-frame { max-width: 60rem; margin: var(--head-gap) auto 0; }

      /* business workflows */
      .flows { padding-block: var(--section-y); }
      .flows-inner { display: grid; gap: 2.5rem; }
      @media (min-width: 64rem) { .flows-inner { grid-template-columns: 1fr 1fr; align-items: center; } }
      .flows-copy h2 { margin: .6rem 0 0; font-size: clamp(1.9rem,3.7vw,2.7rem); line-height: 1.05; }
      .flows-il { margin: 1.8rem 0 0; }
      .flows-il img { display: block; width: 100%; height: auto; max-width: 30rem; }
      .flow-cards { display: grid; gap: 1rem; }
      .flow-card { background: var(--card); border: 1px solid var(--border); padding: var(--card-pad); }
      .flow-card h3 { margin: 0 0 .8rem; font-size: 1.05rem; }
      .chips { display: flex; flex-wrap: wrap; align-items: center; gap: .4rem; margin: 0; padding: 0; list-style: none; counter-reset: c; }
      .chips li { display: inline-flex; align-items: center; padding: .3rem .6rem; background: var(--background); border: 1px solid var(--border); font-family: var(--font-mono); font-size: .74rem; color: var(--foreground); }
      .chips li:not(:last-child)::after { content: "→"; margin-left: .55rem; color: var(--primary); }

      /* docs / quickstart */
      .docs { padding-block: var(--section-y); }
      .qs-grid { display: grid; gap: 2.5rem; margin-top: var(--head-gap); }
      @media (min-width: 62rem) { .qs-grid { grid-template-columns: 1fr 1fr; } }
      .qs-steps { display: grid; gap: 1rem; margin: 0; padding: 0; list-style: none; }
      .qs-steps li { display: grid; grid-template-columns: auto 1fr; gap: .9rem; align-items: start; }
      .qs-n { display: grid; place-items: center; width: 1.6rem; height: 1.6rem; background: var(--primary); color: #fff; font-family: var(--font-mono); font-size: .78rem; font-weight: 600; }
      .qs-steps strong { display: block; font-family: var(--font-display); font-size: .98rem; margin-bottom: .3rem; }
      .qs-steps code { display: block; overflow-x: auto; padding: .5rem .6rem; background: #15151f; color: #c7c9e0; border: 1px solid #2a2b3d; font-family: var(--font-mono); font-size: .76rem; }
      .docs-cards { display: grid; gap: 1px; background: var(--border); border: 1px solid var(--border); align-content: start; }
      @media (min-width: 32rem) { .docs-cards { grid-template-columns: 1fr 1fr; } }
      .doc-card { display: block; background: var(--card); padding: var(--card-pad); color: inherit; text-decoration: none; transition: background .15s; }
      .doc-card:hover { background: color-mix(in oklab, var(--primary) 5%, var(--card)); }
      .doc-card h3 { display: flex; align-items: center; gap: .4rem; margin: 0 0 .35rem; font-size: 1rem; }
      .doc-card p { margin: 0; color: var(--muted-foreground); font-size: .86rem; line-height: 1.45; }
      .parr { color: var(--primary); opacity: 0; transform: translateX(-.25rem); transition: opacity .15s, transform .15s; }
      .doc-card:hover .parr, .doc-card:focus-visible .parr { opacity: 1; transform: none; }

      /* faq */
      .faq { padding-block: var(--section-y); }
      .faq-list { max-width: 48rem; margin: var(--head-gap) auto 0; border-top: 1px solid var(--border); }
      .qa { border-bottom: 1px solid var(--border); }
      .qa summary { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1.2rem .2rem; cursor: pointer; list-style: none; font-family: var(--font-display); font-weight: 600; font-size: 1.05rem; color: var(--foreground); }
      .qa summary::-webkit-details-marker { display: none; }
      .q-mark { color: var(--primary); font-family: var(--font-mono); font-size: 1.3rem; transition: transform .2s; }
      .qa[open] .q-mark { transform: rotate(45deg); }
      .qa p { margin: 0 0 1.2rem; max-width: 44rem; color: var(--muted-foreground); line-height: 1.6; }
      .qa[open] p { animation: fadeUp .3s cubic-bezier(.2,.7,.2,1); }

      /* cta */
      .cta { text-align: center; padding-block: calc(var(--section-y) * 1.5); }
      .cta h2 { margin: 0; font-size: clamp(2.1rem,4.4vw,3.2rem); }
      .cta p { margin: .8rem auto 0; max-width: 36rem; color: var(--muted-foreground); }
      .cta .actions { justify-content: center; }

      /* footer */
      .ftr { padding-block: 3rem 2.2rem; border-top: 1px solid var(--border); }
      .ftr-top { display: grid; gap: 2.5rem; }
      @media (min-width: 52rem) { .ftr-top { grid-template-columns: 1.1fr 2fr; } }
      .ftr-brand .brand-sm { font-family: var(--font-display); font-weight: 700; font-size: 1.2rem; color: var(--foreground); }
      .ftr-brand p { margin: .6rem 0 0; max-width: 22rem; color: var(--muted-foreground); font-size: .9rem; line-height: 1.5; }
      .ftr-cols { display: grid; grid-template-columns: repeat(2,1fr); gap: 1.5rem; }
      @media (min-width: 44rem) { .ftr-cols { grid-template-columns: repeat(4,1fr); } }
      .ftr-cols h4 { margin: 0 0 .8rem; font-family: var(--font-mono); font-size: .72rem; letter-spacing: .08em; text-transform: uppercase; color: var(--muted-foreground); font-weight: 500; }
      .ftr-cols a { display: block; padding: .3rem 0; color: var(--foreground); text-decoration: none; font-size: .9rem; }
      .ftr-cols a:hover { color: var(--primary); }
      .ftr-legal { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .5rem; margin-top: var(--head-gap); padding-top: 1.5rem; border-top: 1px solid var(--border); color: var(--muted-foreground); font-size: .82rem; }

      /* motion */
      .reveal { opacity: 0; transform: translateY(14px); animation: fadeUp .7s cubic-bezier(.2,.7,.2,1) forwards; animation-delay: var(--d,0s); }
      @keyframes fadeUp { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
      /* scroll-reveal — .pre is added by JS only when IO exists and motion is allowed, so no-JS
       * and reduced-motion readers always see static content */
      :global(.pre) { opacity: 0; transform: translateY(14px); transition: opacity .65s cubic-bezier(.2,.7,.2,1), transform .65s cubic-bezier(.2,.7,.2,1); }
      :global(.pre.in) { opacity: 1; transform: none; }
      @media (max-width: 48rem) { .nav { display: none; } .mobile-nav { display: block; } }
      @media (prefers-reduced-motion: reduce) {
        .reveal { animation: none; opacity: 1; transform: none; }
        .qa[open] p { animation: none; }
        .cov-legend .dot.live { animation: none; }
        /* belt-and-braces: the reveal script already skips reduced-motion at load, but this also
         * covers a mid-session OS toggle */
        .cap-grid.in .cap-ic :global(:is(path, circle, rect)) { animation: none; }
        .cap-ic :global(.acc) { transition: none; }
        .cap-card:hover .cap-ic :global(.acc) { transform: none; }
      }
      :is(a, summary, details):focus-visible { outline: 2px solid var(--ring); outline-offset: 3px; }
    </style>
  </body>
