---
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Fabric</title>
    <meta
      name="description"
      content="Placeholder public landing shell for Fabric."
    />
  </head>
  <body>
    <main class="site-shell">
      <header class="site-header">
        <a class="brand" href="/">Fabric</a>
        <nav class="header-nav" aria-label="Primary">
          <a href="/docs">Docs</a>
        </nav>
      </header>

      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">Public preview</p>
          {/* Placeholder shell copy only. Final landing copy/design is w-2. */}
          <h1 id="hero-title">Messaging and payments infrastructure for teams.</h1>
          <p>
            Placeholder landing shell for Fabric's public site. Final positioning,
            proof points, pricing, and design treatment are intentionally deferred.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="#">Start free</a>
            <a class="button button-secondary" href="/docs">Read the docs</a>
          </div>
        </div>
      </section>

      <section class="features" aria-label="Placeholder features">
        <article class="feature-card">
          <h2>Messaging</h2>
          <p>Placeholder summary for SMS, delivery reports, and sender IDs.</p>
        </article>
        <article class="feature-card">
          <h2>Email</h2>
          <p>Placeholder summary for managed email and domain setup.</p>
        </article>
        <article class="feature-card">
          <h2>Wallet</h2>
          <p>Placeholder summary for balances, reservations, and billing.</p>
        </article>
      </section>

      <footer class="site-footer">
        <span>Fabric</span>
        <a class="footer-link" href="/docs">Developer docs</a>
      </footer>
    </main>
  </body>
</html>
