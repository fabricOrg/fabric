---
// SIGNATURE MOMENT — "one message, end to end".
//
// The whole section is ONE pinned stage. Fabric sits fixed at the centre and stays there; scrolling
// does not move the illustration, it advances the REQUEST through the platform. Each scroll beat
// lights the next node on the pipeline and swaps the panel Fabric is currently emitting.
//
// This replaces the earlier per-row "catch & release" pairing, where every stage had its own sticky
// card that had to meet its copy at the row's end. That alignment depended on the row height
// matching the sticky range exactly, so the card and its copy drifted apart (~400px), consecutive
// stages overlapped, and the section grew to ~7,500px of mostly dead space. One pinned stage cannot
// drift: there is only ever a single visual on screen, and every pixel of scroll advances the story.
//
// Native scroll only — no scroll-jacking. JS just maps scroll depth to an active index; without it
// the stages render as a plain, fully visible sequence.
const stages = [
  { n: "01", key: "call", title: "You call send()", copy: "One typed SDK call, addressed by template key. SMS or email is a setting — not new code." },
  { n: "02", key: "render", title: "Fabric renders it", copy: "Variables fill in and the exact cost is known before anything leaves the building." },
  { n: "03", key: "reserve", title: "The wallet reserves", copy: "Fabric holds the cost against your balance. No hold, no send — that rule has no exceptions." },
  { n: "04", key: "route", title: "Fabric picks the route", copy: "A provider is selected per destination, with retries and failover owned by the platform." },
  { n: "05", key: "deliver", title: "It lands", copy: "Delivered under your approved sender ID, with DND and quiet hours respected." },
  { n: "06", key: "webhook", title: "Your server hears back", copy: "A signed, retried event reports the terminal state. At-least-once, from a durable outbox." },
  { n: "07", key: "settle", title: "The ledger settles", copy: "The hold becomes a charge, analytics update, and every movement reconciles." },
];
---

<section class="lc" aria-label="One Fabric message, end to end">
  <div class="lc-head">
    <p class="num">The lifecycle</p>
    <h2>One message, <span class="hl">end to end</span>.</h2>
    <p class="lc-lede">Fabric stays put. Scroll, and watch the request move through it.</p>
  </div>

  <div class="lc-track" data-track style={`--stages:${stages.length}`}>
    <!-- the pinned stage: Fabric at centre, panels emitted beside it -->
    <div class="lc-stage">
      <div class="lc-core" aria-hidden="true">
        <div class="lc-rail">
          {stages.map((s, i) => (
            <span class="lc-node" data-node={i}><i></i><em>{s.n}</em></span>
          ))}
        </div>
        <div class="lc-hub">
          <span class="lc-hub-pulse"></span>
          <span class="lc-hub-mark">Fabric</span>
        </div>
      </div>

      <div class="lc-panels">
        {stages.map((s, i) => (
          <div class="lc-panel" data-panel={i} data-key={s.key}>
            <div class="lc-panel-copy">
              <span class="lc-n">{s.n}</span>
              <h3>{s.title}</h3>
              <p>{s.copy}</p>
            </div>

            {s.key === "call" && (
              <div class="lc-code">
                <div class="ed"><span class="dots"><i></i><i></i><i></i></span><em>send.ts</em></div>
                <pre><code><span class="k">await</span> fabric.messages.<span class="f">send</span>(<span class="s">"order.shipped"</span>, {'{'}
  <span class="p">to</span>: <span class="s">"+233201234567"</span>,
  <span class="p">data</span>: {'{'} <span class="p">ref</span>: <span class="s">"GH-4821"</span> {'}'},
{'}'});</code></pre>
              </div>
            )}

            {s.key === "render" && (
              <div class="lc-card">
                <div class="lc-card-head"><span>Rendered message</span><span class="badge sms">SMS</span></div>
                <div class="bubble"><p>Hi Ama, your order GH-4821 has shipped.</p></div>
                <div class="meta"><span>1 segment · GSM-7</span><span class="cost">GHS 0.03</span></div>
              </div>
            )}

            {s.key === "reserve" && (
              <div class="lc-card">
                <div class="lc-card-head"><span>Wallet</span><span class="muted">GHS</span></div>
                <div class="wal"><span class="wal-b">GHS 412.60</span><span class="wal-d">− 0.03 held</span></div>
                <div class="row"><span class="tag hold">HOLD</span><span class="rk">order.shipped</span><span class="amt">−0.03</span></div>
              </div>
            )}

            {s.key === "route" && (
              <div class="lc-card">
                <div class="lc-card-head"><span>Routing</span><span class="muted">GH · MTN</span></div>
                <div class="row"><span class="tag queue">QUEUED</span><span class="rk">primary route</span><span class="st sending">selected</span></div>
                <div class="an-foot">Retries and failover are the platform's problem, <strong>not yours</strong></div>
              </div>
            )}

            {s.key === "deliver" && (
              <div class="lc-card">
                <div class="lc-card-head"><span>Delivery</span><span class="badge sms">SMS</span></div>
                <div class="row"><span class="rk">order.shipped</span><span class="st delivered">delivered</span><span class="amt">GHS 0.03</span></div>
                <div class="tl"><span>queued</span><span>sent</span><span class="on">delivered</span></div>
              </div>
            )}

            {s.key === "webhook" && (
              <div class="lc-code">
                <div class="ed"><span class="dots"><i></i><i></i><i></i></span><em>POST /your/webhook</em></div>
                <pre><code>{'{'}
  <span class="p">"type"</span>: <span class="s">"message.delivered"</span>,
  <span class="p">"data"</span>: {'{'} <span class="p">"deliveryId"</span>: <span class="s">"dlv_8f2…"</span> {'}'}
{'}'}</code></pre>
              </div>
            )}

            {s.key === "settle" && (
              <div class="lc-card">
                <div class="lc-card-head"><span>Analytics</span><span class="muted">7 days</span></div>
                <div class="bars"><span style="--h:40%;--bi:0"></span><span style="--h:55%;--bi:1"></span><span style="--h:48%;--bi:2"></span><span style="--h:66%;--bi:3"></span><span style="--h:72%;--bi:4"></span><span style="--h:61%;--bi:5"></span><span style="--h:88%;--bi:6"></span></div>
                <div class="an-foot">Hold became a charge — <strong>reconciled</strong> to the ledger</div>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>

    <!-- scroll runway: one marker per stage, purely to measure depth -->
    <div class="lc-marks" aria-hidden="true">
      {stages.map((_, i) => <span class="lc-mark" data-mark={i}></span>)}
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const section = document.currentScript.previousElementSibling;
    const track = section.querySelector("[data-track]");
    const marks = [...track.querySelectorAll(".lc-mark")];
    const panels = [...track.querySelectorAll(".lc-panel")];
    const nodes = [...track.querySelectorAll(".lc-node")];
    // Pinning and panel swapping only exist once JS runs; no-JS readers get the plain sequence.
    track.classList.add("js");
    let current = -1;
    const setActive = (i) => {
      if (i === current) return;
      current = i;
      panels.forEach((p, n) => p.classList.toggle("is-on", n === i));
      nodes.forEach((nd, n) => {
        nd.classList.toggle("is-on", n === i);
        nd.classList.toggle("is-done", n < i);
      });
      track.style.setProperty("--fill", `${(i / (marks.length - 1)) * 100}%`);
    };
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) setActive(Number(e.target.dataset.mark));
        }
      },
      // a marker owns the beat while it straddles the viewport's middle band
      { rootMargin: "-50% 0px -50% 0px", threshold: 0 },
    );
    marks.forEach((m) => io.observe(m));
    setActive(0);
  })();
</script>

<style>
  .lc { margin-inline: auto; width: min(100% - 3rem, var(--maxw)); padding-block: var(--section-y); }
  .lc-head { max-width: 44rem; margin: 0 auto clamp(2rem, 4vw, 3.25rem); text-align: center; }
  .num { margin: 0; color: var(--gold-ink); font-family: var(--font-mono); font-size: .75rem; letter-spacing: .1em; text-transform: uppercase; }
  .lc-head h2 { margin: .6rem 0 0; font-family: var(--font-display); font-weight: 700; font-size: clamp(1.9rem,3.7vw,2.7rem); line-height: 1.05; }
  .hl { color: var(--primary); }
  .lc-lede { margin: 1rem auto 0; max-width: 40rem; color: var(--muted-foreground); line-height: 1.6; }

  .lc-track { position: relative; }
  .lc-marks { display: none; }

  /* ---------- no-JS / small screens: a plain readable sequence ---------- */
  /* min-width:0 everywhere down the chain: the code panel sets a wide min-content via
   * `white-space: pre`, and a grid item defaults to min-width:auto, so without this the panel
   * refuses to shrink, its siblings stretch to match, and the page overflows sideways on mobile.
   * With it, the `pre` scrolls inside itself instead. */
  .lc-panels, .lc-panel, .lc-panel-copy, .lc-code, .lc-card { min-width: 0; }
  .lc-panel { display: grid; gap: 1.1rem; }
  .lc-panel + .lc-panel { margin-top: 3rem; }
  .lc-core { display: none; }
  .lc-n { display: inline-grid; place-items: center; width: 2rem; height: 2rem; margin-bottom: .7rem; border-radius: 50%; background: color-mix(in oklab, var(--primary) 12%, var(--card)); border: 2px solid var(--primary); color: var(--primary); font: 600 .72rem var(--font-mono); }
  .lc-panel-copy h3 { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: clamp(1.5rem,2.6vw,2rem); line-height: 1.12; }
  .lc-panel-copy p { margin: .7rem 0 0; max-width: 32rem; color: var(--muted-foreground); font-size: 1.02rem; line-height: 1.55; }

  /* ---------- the pinned stage (JS + desktop) ---------- */
  @media (min-width: 60rem) {
    .lc-track.js { height: calc(var(--stages) * 82vh); }
    .lc-track.js .lc-marks { display: grid; position: absolute; inset: 0; grid-template-rows: repeat(var(--stages), 1fr); pointer-events: none; }
    .lc-track.js .lc-stage {
      position: sticky; top: 0; height: 100vh;
      display: grid; grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
      align-items: center; column-gap: clamp(3rem, 6vw, 6rem);
    }
    /* rail + hub read as ONE object: the stage spine feeding Fabric, which emits the panel */
    .lc-track.js .lc-core { position: relative; display: grid; grid-template-columns: auto auto; align-items: center; justify-content: center; column-gap: clamp(1.1rem, 2vw, 2rem); }
    .lc-track.js .lc-rail { margin-bottom: 0; }
    /* every panel occupies the same cell — only the active one is visible, so nothing can overlap */
    .lc-track.js .lc-panels { position: relative; display: grid; }
    .lc-track.js .lc-panel { grid-area: 1 / 1; margin: 0; align-content: center;
      opacity: 0; transform: translateY(14px); pointer-events: none;
      transition: opacity .45s ease, transform .45s cubic-bezier(.2,.7,.2,1); }
    .lc-track.js .lc-panel.is-on { opacity: 1; transform: none; pointer-events: auto; }
  }

  /* Fabric — the fixed centre. The hub never moves; the rail beside it advances. */
  .lc-hub { position: relative; display: grid; place-items: center; width: 9.5rem; height: 9.5rem; margin-inline: auto;
    background: var(--primary); border-radius: 1.6rem; box-shadow: 0 40px 80px -50px color-mix(in oklab, var(--primary) 70%, transparent); }
  .lc-hub-mark { font-family: var(--font-display); font-weight: 700; font-size: 1.35rem; color: #fff; letter-spacing: -.01em; }
  .lc-hub-pulse { position: absolute; inset: 0; border-radius: inherit; border: 2px solid var(--primary); animation: lcPulse 2.8s ease-out infinite; }
  /* the emit line — Fabric hands the request to whatever panel is live */
  @media (min-width: 60rem) {
    .lc-track.js .lc-hub::after { content: ""; position: absolute; left: 100%; top: 50%; width: clamp(1.5rem, 4vw, 4rem); height: 2px; background: linear-gradient(90deg, var(--primary), color-mix(in oklab, var(--primary) 10%, transparent)); transform: translateY(-50%); }
  }
  @keyframes lcPulse { 0% { transform: scale(1); opacity: .55; } 70%, 100% { transform: scale(1.28); opacity: 0; } }

  /* the pipeline rail — seven nodes, lit as the request reaches them */
  .lc-rail { position: relative; display: grid; gap: .85rem; margin-bottom: 1.9rem; padding-left: .35rem; }
  .lc-rail::before { content: ""; position: absolute; left: .85rem; top: .4rem; bottom: .4rem; width: 2px; background: color-mix(in oklab, var(--foreground) 12%, transparent); }
  .lc-rail::after { content: ""; position: absolute; left: .85rem; top: .4rem; width: 2px; height: var(--fill, 0%); background: var(--primary); transition: height .4s ease; }
  .lc-node { position: relative; display: flex; align-items: center; gap: .7rem; }
  .lc-node i { position: relative; z-index: 1; width: 1rem; height: 1rem; border-radius: 50%; background: var(--background); border: 2px solid color-mix(in oklab, var(--foreground) 18%, transparent); transition: border-color .3s, background .3s, box-shadow .3s; }
  .lc-node em { font: 400 .72rem var(--font-mono); font-style: normal; color: var(--muted-foreground); transition: color .3s; }
  .lc-node.is-done i { background: var(--primary); border-color: var(--primary); }
  .lc-node.is-on i { border-color: var(--primary); background: color-mix(in oklab, var(--primary) 20%, var(--background)); box-shadow: 0 0 0 5px color-mix(in oklab, var(--primary) 13%, transparent); }
  .lc-node.is-on em { color: var(--primary); font-weight: 600; }

  /* card frame */
  .lc-card { display: grid; gap: .9rem; padding: 1.4rem; background: var(--card); border: 1px solid var(--border); box-shadow: 0 28px 60px -44px rgba(20,20,32,.5); }
  .lc-card-head { display: flex; align-items: center; justify-content: space-between; font-family: var(--font-display); font-weight: 600; font-size: .95rem; color: var(--foreground); }
  .lc-card-head .muted { font-family: var(--font-mono); font-size: .74rem; font-weight: 400; color: var(--muted-foreground); }
  .badge { padding: .18rem .5rem; font: 700 .6rem var(--font-mono); color: #fff; }
  .badge.sms { background: var(--sms); } .badge.email { background: var(--email); }

  /* code editor panel */
  .ed { display: flex; align-items: center; gap: .45rem; padding: .6rem .85rem; background: #1c1d29; border: 1px solid #2a2b3d; border-bottom: 0; }
  .dots { display: inline-flex; gap: .3rem; } .dots i { width: .58rem; height: .58rem; border-radius: 50%; background: #ff5f57; } .dots i:nth-child(2){ background:#febc2e; } .dots i:nth-child(3){ background:#28c840; }
  .ed em { margin-left: auto; font-family: var(--font-mono); font-style: normal; font-size: .74rem; color: #6b6f8c; }
  .lc-code pre { margin: 0; padding: 1.2rem 1.3rem; background: #15151f; border: 1px solid #2a2b3d; overflow-x: auto; }
  .lc-code code { font-family: var(--font-mono); font-size: .9rem; line-height: 1.8; color: #cdd0e5; white-space: pre; }
  .lc-code .k { color:#c792ea; } .lc-code .s { color:#7ee787; } .lc-code .f { color:#61afef; } .lc-code .p { color:#e5c07b; }

  /* rendered bubble */
  .bubble { padding: 1.1rem 1.15rem; background: var(--background); border: 1px solid var(--border); border-left: 3px solid var(--sms); }
  .bubble p { margin: 0; color: var(--foreground); font-size: .98rem; line-height: 1.5; }
  .meta { display: flex; justify-content: space-between; font-family: var(--font-mono); font-size: .78rem; color: var(--muted-foreground); }
  .meta .cost { color: var(--foreground); }

  /* wallet */
  .wal { display: flex; align-items: baseline; justify-content: space-between; padding: .9rem 1rem; background: var(--background); border: 1px solid var(--border); }
  .wal-b { font-family: var(--font-mono); font-size: 1.25rem; color: var(--foreground); }
  .wal-d { font-family: var(--font-mono); font-size: .78rem; color: var(--gold-ink); }

  /* rows */
  .row { display: flex; align-items: center; gap: .7rem; padding: .8rem .9rem; background: var(--background); border: 1px solid var(--border); font-size: .92rem; }
  .rk { flex: 1; font-family: var(--font-mono); color: var(--foreground); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .tag, .st { padding: .16rem .5rem; font: 700 .62rem var(--font-mono); color: #fff; }
  .tag.hold { background: var(--gold-ink); } .tag.queue { background: var(--muted-foreground); }
  .st { font-weight: 600; }
  .st.sending { background: var(--warn); } .st.delivered { background: var(--ok); }
  .amt { font-family: var(--font-mono); font-size: .82rem; color: var(--foreground); }

  /* delivery timeline */
  .tl { display: flex; align-items: center; gap: .5rem; font-family: var(--font-mono); font-size: .74rem; color: var(--muted-foreground); }
  .tl span:not(:last-child)::after { content: "→"; margin-left: .5rem; color: color-mix(in oklab, var(--foreground) 30%, transparent); }
  .tl .on { color: var(--ok); font-weight: 600; }

  /* analytics */
  .bars { display: flex; align-items: flex-end; gap: .4rem; height: 6.5rem; padding: .9rem; background: var(--background); border: 1px solid var(--border); }
  .bars span { flex: 1; height: var(--h); background: color-mix(in oklab, var(--primary) 65%, transparent); border-radius: 2px 2px 0 0; transform-origin: bottom; }
  .bars span:last-child { background: var(--primary); }
  .lc-panel.is-on .bars span { animation: lcGrow .6s cubic-bezier(.2,.7,.2,1) both; animation-delay: calc(var(--bi) * 55ms); }
  @keyframes lcGrow { from { transform: scaleY(0); } }
  .an-foot { font-size: .82rem; color: var(--muted-foreground); } .an-foot strong { color: var(--foreground); font-family: var(--font-mono); }

  @media (prefers-reduced-motion: reduce) {
    .lc-hub-pulse, .lc-panel.is-on .bars span { animation: none; }
    .lc-rail::after { transition: none; }
    .lc-track.js .lc-panel { transition: opacity .01s linear; transform: none; }
  }
</style>
