# Admin console — staff control plane.
# When these are set, the "Create tenant" flow calls the real staff endpoint
# (services/api POST /internal/admin/tenants: WorkOS org → account → invite).
# Leave unset to use the offline mock. The real path is an external write — use STAGING + test creds.
API_BASE_URL=http://localhost:3000
BFF_INTERNAL_TOKEN=localdev-bff-token-change-before-sharing
